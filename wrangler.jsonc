/**
 * we-learning-suite-ai —— 出题 AI Worker
 *
 * 职责：接收 we-learning-suite-api 的服务端触发（ticket + 文档下载链接），
 * 异步完成「下载文档 → 格式分诊 → OCR（仅图片）→ 多提供商故障切换生成题目 → 校验 → 回写题库」。
 * 客户端全程不知道本 Worker 的存在。
 *
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "we-learning-suite-ai",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-03",
	// 关闭公网入口：本 Worker 只能通过 we-learning-suite-api 的 Service Binding 调用，
	// 任何外部请求（含客户端）物理上无法到达。Queue 消费者不受影响。
	"workers_dev": false,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * 非敏感环境变量（敏感信息用 wrangler secret put 设置）
	 */
	"vars": {
		// 模型提供商列表（OpenAI 兼容端点），JSON 数组，数量不限，按 priority 升序尝试故障切换。
		// 字段：name（唯一标识，决定 secret 名）/ priority（越小越优先）/ baseUrl /
		//       generateModel（生成模型）/ ocrModel（可选，不填则 OCR 阶段跳过该家）
		"AI_PROVIDERS": "[{\"name\":\"main\",\"priority\":1,\"baseUrl\":\"http://aigw.dlut.edu.cn/v1\",\"generateModel\":\"Qwen3.5-122B-A10B\",\"ocrModel\":\"PaddleOCR-VL-1.5\",\"planModel\":\"Qwen3-Next-80B-A3B-Thinking\"},{\"name\":\"mimo\",\"priority\":2,\"baseUrl\":\"https://api.xiaomimimo.com/v1\",\"generateModel\":\"mimo-v2.5-pro\",\"ocrModel\":\"mimo-v2.5\"},{\"name\":\"deepseek\",\"priority\":3,\"baseUrl\":\"https://api.deepseek.com\",\"generateModel\":\"deepseek-v4-flash\"}]",
	},
	/**
	 * 以下变量通过 `npx wrangler secret put <NAME>` 设置，不写在配置文件里：
	 * AI_PROVIDER_KEY_<NAME> - 每个提供商一个令牌，<NAME> 为提供商 name 的大写形式
	 *                          （如 name=main 对应 AI_PROVIDER_KEY_MAIN；
	 *                            name=deepseek 对应 AI_PROVIDER_KEY_DEEPSEEK）
	 */
	// R2 对象存储绑定 —— 直接读取 API Worker 上传的文件（不走公网预签名 URL）
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "we-learning-suite"
		}
	],

	// Service Binding → we-learning-suite-api（验票 / 状态回写 / 题目入库）
	"services": [
		{
			"binding": "API_WORKER",
			"service": "we-learning-suite-api"
		}
	],
	// Durable Object：每个出题任务一个实例，用 alarm 状态机绕过 900s wall time 限制
	"durable_objects": {
		"bindings": [
			{
				"name": "QUIZ_DO",
				"class_name": "QuizGenerationDO"
			},
			{
				"name": "OCR_DO",
				"class_name": "OCRProcessingDO"
			}
		]
	},
	"migrations": [
		{
			// 此 tag 已在线应用（当初仅注册 QuizGenerationDO）；
			// 切勿改动已应用的迁移，Cloudflare 不会重新执行它。
			"tag": "v1",
			// 免费套餐要求 SQLite 存储后端（API 错误 10097）；
			// storage API 与旧后端完全一致，alarm 行为不变
			"new_sqlite_classes": ["QuizGenerationDO"]
		},
		{
			// 新增迁移：补登 OCRProcessingDO。
			// 原被错误地加进 v1，但 v1 早已应用过、不会重新执行，导致 10061。
			"tag": "v2",
			"new_sqlite_classes": ["OCRProcessingDO"]
		}
	],
	"queues": {
		// 受理端点把任务写入队列
		"producers": [
			{
				"queue": "quiz-generation",
				"binding": "QUIZ_QUEUE"
			}
		],
		// 本 Worker 自己消费：一次处理一条（出题是长任务），失败最多重试 2 次
		"consumers": [
			{
				"queue": "quiz-generation",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 2
			}
		]
	}
}
