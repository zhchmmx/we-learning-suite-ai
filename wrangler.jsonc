/**
 * we-learning-suite-ai —— 出题 AI Worker
 *
 * 职责：接收 we-learning-suite-api 的服务端触发（ticket + R2 key，直读 R2），
 * 异步完成「读取材料 → 格式分诊 → toMarkdown / OCR → AI Gateway 生成题目 → 校验 → 回写题库」。
 * 客户端全程不知道本 Worker 的存在。
 *
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "we-learning-suite-ai",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-03",
	// 关闭公网入口：本 Worker 只能通过 we-learning-suite-api 的 Service Binding 调用，
	// 任何外部请求（含客户端）物理上无法到达。Queue 消费者不受影响。
	"workers_dev": false,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Workers AI 绑定（通过 AI Gateway 路由，故障切换由 Gateway 负责）
	"ai": {
		"binding": "AI"
	},
	/**
	 * 非敏感环境变量（敏感信息用 wrangler secret put 设置）
	 */
	"vars": {
		// 模型选择开关："true" 直连 config.ts 里的具体模型链（代码内按序 fallback）；
		// "false" 恢复 AI Gateway dynamic 路由（下方三个 AI_*_MODEL 路由名）
		"USE_DIRECT_MODELS": "false",
		// AI Gateway 路由名（三阶段各一个，Gateway 负责模型选择与 fallback）。
		// 当前被 USE_DIRECT_MODELS="true" 旁路，暂不使用；改回 "false" 即恢复。
		"AI_GENERATE_MODEL": "dynamic/generate_auto",
		"AI_OCR_MODEL": "dynamic/ocr_auto",
		"AI_PLAN_MODEL": "dynamic/plan_auto",
		// AI Gateway ID（env.AI.run() 的 gateway.id 参数）
		"AI_GATEWAY_ID": "we-learning-suite-ai-gateway",
		// Cloudflare 账号 ID（AI Gateway Logs API 路径用；wrangler whoami 查得）
		"CF_ACCOUNT_ID": "28d750ec737e82aa6204afa76b9b9295",
		// ── Waffo scan-prompt 内容审核 ──
		// 商户 ID（非敏感，普通环境变量即可）
		"WAFFO_MERCHANT_ID": "MER_366aA3JhhsRSJ7ffU8E2Wr",
		// 扫描服务地址（沙箱可用时改这里）
		"WAFFO_SCAN_BASE_URL": "https://api.waffo.ai",
		// 内容审核总开关："true" 启用；出问题改回 "false" 即回到无审核原行为
		"CONTENT_SCAN_ENABLED": "true",
		// 单次扫描字符上限（API 硬上限 10000，留 1000 余量）
		"SCAN_MAX_CHARS": "9000",
		// 输入侧分块 / 输出侧逐题扫描的并发数
		"SCAN_CONCURRENCY": "4",
		// 单次扫描请求超时（毫秒）
		"SCAN_TIMEOUT_MS": "15000",
			// 本地调试端点开关：云端永远 false（安全声明）；本地 .dev.vars 覆盖为 true
			"ENABLE_DEBUG_EXTRACT": "false"
	},
	/**
	 * 以下变量通过 `npx wrangler secret put <NAME>` 设置，不写在配置文件里：
	 * WAFFO_PRIVATE_KEY - Waffo 商户私钥（裸 Base64 字符串，PKCS#8 DER）
	 */
	// R2 对象存储绑定 —— 直接读取 API Worker 上传的文件（不走公网预签名 URL）
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "we-learning-suite"
		}
	],

	// Service Binding → we-learning-suite-api（验票 / 状态回写 / 题目入库）
	"services": [
		{
			"binding": "API_WORKER",
			"service": "we-learning-suite-api"
		}
	],
	// Durable Object：每个出题任务一个实例，用 alarm 状态机绕过 900s wall time 限制
	"durable_objects": {
		"bindings": [
			{
				"name": "QUIZ_DO",
				"class_name": "QuizGenerationDO"
			},
			{
				"name": "OCR_DO",
				"class_name": "OCRProcessingDO"
			}
		]
	},
	"migrations": [
		{
			// 此 tag 已在线应用（当初仅注册 QuizGenerationDO）；
			// 切勿改动已应用的迁移，Cloudflare 不会重新执行它。
			"tag": "v1",
			// 免费套餐要求 SQLite 存储后端（API 错误 10097）；
			// storage API 与旧后端完全一致，alarm 行为不变
			"new_sqlite_classes": ["QuizGenerationDO"]
		},
		{
			// 新增迁移：补登 OCRProcessingDO。
			// 原被错误地加进 v1，但 v1 早已应用过、不会重新执行，导致 10061。
			"tag": "v2",
			"new_sqlite_classes": ["OCRProcessingDO"]
		}
	],
	"queues": {
		// 受理端点把任务写入队列
		"producers": [
			{
				"queue": "quiz-generation",
				"binding": "QUIZ_QUEUE"
			}
		],
		// 本 Worker 自己消费：一次处理一条（出题是长任务），失败最多重试 2 次
		"consumers": [
			{
				"queue": "quiz-generation",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 2
			}
		]
	}
}
